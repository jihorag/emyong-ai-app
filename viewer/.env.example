# ─────────────────────────────────────────────────────────────
# 서버(Vercel) 환경변수 — 이 파일을 .env.local로 복사해서 값을 채운다.
#   cp .env.example .env.local
#
# ⚠ .env.local은 절대 커밋하지 않는다(.gitignore 처리됨).
# ⚠ 여기 있는 값은 전부 서버 전용이다. 브라우저로 내려가지 않는다.
#   클라이언트에 노출되는 값이 필요하면 반드시 VITE_ 접두사를 쓸 것 —
#   그건 번들에 그대로 박히므로 시크릿을 넣으면 안 된다.
# ─────────────────────────────────────────────────────────────

# ── 필수 ──────────────────────────────────────────────────────
# Anthropic API 키. /api/ai 프록시가 이 키로 Claude를 호출한다.
# 없으면 내장 AI가 503을 반환하고, 사용자는 각자 키(BYOK)를 넣어야 한다.
ANTHROPIC_API_KEY=sk-ant-...

# ⚠ 사용자 개인 API 키는 여기 두지 않는다. 앱의 ⚙️ 설정 화면에서 입력하며
#   그 값은 해당 기기(localStorage)에만 저장된다. 이 파일은 서버 전용이다.

# ── 접근 제어 ─────────────────────────────────────────────────
# /api/ai 호출을 허용할 호스트. 쉼표 구분.
# 비워 두면 *.vercel.app + localhost 만 허용(개발 기본값).
# 커스텀 도메인을 붙이면 여기에 반드시 추가할 것.
ALLOWED_ORIGINS=

# ── 비용 상한 (선택 — 비우면 아래 기본값) ──────────────────────
# 요청 1건당 max_tokens 상한
AI_MAX_TOKENS_CAP=4096
# IP당 분당 요청 수
AI_RATE_PER_MIN=20
# IP당 일일 요청 수
AI_RATE_PER_DAY=300
# 전체 사용자 합산 일일 요청 수
AI_GLOBAL_PER_DAY=8000

# ⚠ 위 레이트리밋은 현재 서버리스 인스턴스 메모리에 저장된다.
#   인스턴스가 여러 개 뜨거나 콜드스타트가 나면 리셋되므로 실효 상한이 아니다.
#   유료화 전에 KV/Redis 기반으로 교체해야 한다. (감사 보고서 S-02)
